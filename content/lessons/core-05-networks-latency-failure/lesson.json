          {"id": "retry-decision", "label": "retry判断", "detail": "残りdeadlineと冪等性を確認してから再試行する。"}
        ],
        "cells": [
          {"id": "healthy-path", "alternativeId": "healthy", "criterionId": "completed-path", "value": "DNS→TCP→TLS→request→response"},
          {"id": "healthy-observation", "alternativeId": "healthy", "criterionId": "observation", "value": "statusとbodyまで観測"},
          {"id": "healthy-retry", "alternativeId": "healthy", "criterionId": "retry-decision", "value": "retry不要"},
          {"id": "dns-path", "alternativeId": "dns-point", "criterionId": "completed-path", "value": "DNS→failure observation→retry decision/recovery"},
          {"id": "dns-observation", "alternativeId": "dns-point", "criterionId": "observation", "value": "resolver結果とTTL"},
          {"id": "dns-retry", "alternativeId": "dns-point", "criterionId": "retry-decision", "value": "残りdeadline内で再解決"},
          {"id": "tcp-path", "alternativeId": "tcp-point", "criterionId": "completed-path", "value": "DNS→TCP→failure observation→retry decision/recovery"},
          {"id": "tcp-observation", "alternativeId": "tcp-point", "criterionId": "observation", "value": "connect timeoutとaddress"},
          {"id": "tcp-retry", "alternativeId": "tcp-point", "criterionId": "retry-decision", "value": "別addressとbudgetを確認"},
          {"id": "tls-path", "alternativeId": "tls-point", "criterionId": "completed-path", "value": "DNS→TCP→TLS failure→retry blocked/config repair"},
          {"id": "tls-observation", "alternativeId": "tls-point", "criterionId": "observation", "value": "version、証明書、identity"},
          {"id": "tls-retry", "alternativeId": "tls-point", "criterionId": "retry-decision", "value": "設定不整合なら盲目的retry禁止"},
          {"id": "request-path-cell", "alternativeId": "request-point", "criterionId": "completed-path", "value": "DNS→TCP→TLS→request timeout→retry decision/recovery"},
          {"id": "request-observation", "alternativeId": "request-point", "criterionId": "observation", "value": "送信量とserver trace"},
          {"id": "request-retry", "alternativeId": "request-point", "criterionId": "retry-decision", "value": "冪等性と残りdeadlineを確認"},
          {"id": "response-path", "alternativeId": "response-point", "criterionId": "completed-path", "value": "DNS→TCP→TLS→request sent→response unobserved→side-effect inquiry→retry decision"},
          {"id": "response-observation", "alternativeId": "response-point", "criterionId": "observation", "value": "side effectとresponseを別々に照会"},
          {"id": "response-retry", "alternativeId": "response-point", "criterionId": "retry-decision", "value": "同じ冪等keyで結果照会またはretry"}
        ]
      },
      "simulation": {
        "kind": "request-path", "interactionMode": "hybrid", "initialStateId": "dns-lookup", "defaultIntervalMs": 1000,
        "parameters": [
          {"id":"fault","label":"failure注入点","control":"select","options":[{"id":"ok","label":"なし"},{"id":"dns","label":"DNS"},{"id":"tcp","label":"TCP"},{"id":"tls","label":"TLS"},{"id":"req","label":"request"},{"id":"resp","label":"response喪失"}],"defaultOptionId":"ok"},
          {"id":"budget","label":"latency profile","control":"radio","options":[{"id":"n","label":"normal-budget: elapsed=1900ms, remaining=100ms"},{"id":"t","label":"tight-budget(+1ms overhead): elapsed=1901ms, remaining=99ms"}],"defaultOptionId":"n"}
        ],
        "states": [
          {"id":"dns-lookup","label":"DNS","status":"DNS→TCP→TLS→request。total=2000ms; first=800ms+backoff=100ms+second=700ms+post=200ms+cancel=100ms=planned=1900ms。retry開始条件 remaining>=100ms。","activeNodeIds":["completed-path"],"activeEdgeIds":[]},
          {"id":"h-tcp","label":"TCP","status":"DNS完了、TCP接続を確立。","when":{"fault":"ok"},"activeNodeIds":["healthy"],"activeEdgeIds":["healthy-path"]},
          {"id":"tls-ready","label":"TLS","status":"TCP完了、TLS identityを検証。","when":{"fault":"ok"},"activeNodeIds":["healthy"],"activeEdgeIds":["healthy-path"]},
          {"id":"h-req","label":"request","status":"TLS完了、request送信。","when":{"fault":"ok"},"activeNodeIds":["healthy"],"activeEdgeIds":["healthy-path"]},
          {"id":"h-ok","label":"response","status":"elapsed=1900ms; remaining=100ms; budget-gate=allowed。response observed。","when":{"fault":"ok","budget":"n"},"activeNodeIds":["healthy"],"activeEdgeIds":["healthy-path","healthy-observation"]},
          {"id":"h-retry-blocked","label":"no deadline","status":"elapsed=1901ms; remaining=99ms; budget-gate=blocked。response待ち。","when":{"fault":"ok","budget":"t"},"activeNodeIds":["healthy"],"activeEdgeIds":["healthy-path","healthy-retry"]},
          {"id":"d-fail","label":"DNS failure","status":"DNS failure観測。TCP以降は未開始。","when":{"fault":"dns"},"activeNodeIds":["dns-point"],"activeEdgeIds":["dns-path","dns-observation"]},
          {"id":"d-retry","label":"DNS retry","status":"elapsed=1900ms; remaining=100ms; budget-gate=allowed。DNS recovery。","when":{"fault":"dns","budget":"n"},"activeNodeIds":["dns-point"],"activeEdgeIds":["dns-path","dns-retry"]},
          {"id":"d-retry-blocked","label":"DNS blocked","status":"elapsed=1901ms; remaining=99ms; budget-gate=blocked。DNS retry禁止。","when":{"fault":"dns","budget":"t"},"activeNodeIds":["dns-point"],"activeEdgeIds":["dns-path","dns-retry"]},
          {"id":"t-fail","label":"TCP failure","status":"DNS後にTCP failure観測。TLS以降は未開始。","when":{"fault":"tcp"},"activeNodeIds":["tcp-point"],"activeEdgeIds":["tcp-path","tcp-observation"]},
          {"id":"t-retry","label":"TCP retry","status":"elapsed=1900ms; remaining=100ms; budget-gate=allowed。TCP recovery。","when":{"fault":"tcp","budget":"n"},"activeNodeIds":["tcp-point"],"activeEdgeIds":["tcp-path","tcp-retry"]},
          {"id":"t-retry-blocked","label":"TCP blocked","status":"elapsed=1901ms; remaining=99ms; budget-gate=blocked。TCP retry禁止。","when":{"fault":"tcp","budget":"t"},"activeNodeIds":["tcp-point"],"activeEdgeIds":["tcp-path","tcp-retry"]},
          {"id":"l-tcp","label":"TCP before TLS","status":"DNS後にTCP確立。","when":{"fault":"tls"},"activeNodeIds":["tls-point"],"activeEdgeIds":["tls-path"]},
          {"id":"l-fail","label":"TLS failure","status":"TLS設定不整合を観測。","when":{"fault":"tls"},"activeNodeIds":["tls-point"],"activeEdgeIds":["tls-path","tls-observation"]},
          {"id":"l-retry-blocked","label":"TLS repair","status":"elapsed=1900ms; remaining=100ms; budget-gate=allowed。設定不整合なのでretry禁止、config repair。","when":{"fault":"tls","budget":"n"},"activeNodeIds":["tls-point"],"activeEdgeIds":["tls-path","tls-retry"]},
          {"id":"l-retry-blocked-tight","label":"TLS blocked","status":"elapsed=1901ms; remaining=99ms; budget-gate=blocked。TLS retry禁止。","when":{"fault":"tls","budget":"t"},"activeNodeIds":["tls-point"],"activeEdgeIds":["tls-path","tls-retry"]},
          {"id":"q-tcp","label":"request TCP","status":"DNS後にTCP確立。","when":{"fault":"req"},"activeNodeIds":["request-point"],"activeEdgeIds":["request-path-cell"]},
          {"id":"q-tls","label":"request TLS","status":"TCP後にTLS完了。","when":{"fault":"req"},"activeNodeIds":["request-point"],"activeEdgeIds":["request-path-cell"]},
          {"id":"q-fail","label":"request timeout","status":"timeout観測。statusとside effectを照会。","when":{"fault":"req"},"activeNodeIds":["request-point"],"activeEdgeIds":["request-path-cell","request-observation"]},
          {"id":"q-retry","label":"request retry","status":"elapsed=1900ms; remaining=100ms; budget-gate=allowed。status確認後retry decision。","when":{"fault":"req","budget":"n"},"activeNodeIds":["request-point"],"activeEdgeIds":["request-path-cell","request-retry"]},
          {"id":"q-retry-blocked","label":"request blocked","status":"elapsed=1901ms; remaining=99ms; budget-gate=blocked。status照会、retry禁止。","when":{"fault":"req","budget":"t"},"activeNodeIds":["request-point"],"activeEdgeIds":["request-path-cell","request-retry"]},
          {"id":"s-tcp","label":"response TCP","status":"DNS後にTCP確立。","when":{"fault":"resp"},"activeNodeIds":["response-point"],"activeEdgeIds":["response-path"]},
          {"id":"s-tls","label":"response TLS","status":"TCP後にTLS完了。","when":{"fault":"resp"},"activeNodeIds":["response-point"],"activeEdgeIds":["response-path"]},
          {"id":"s-req","label":"request sent","status":"TLS後にrequest送信。","when":{"fault":"resp"},"activeNodeIds":["response-point"],"activeEdgeIds":["response-path"]},
