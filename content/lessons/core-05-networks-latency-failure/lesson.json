{
  "version": 1,
  "id": "core-05-networks-latency-failure",
  "title": "ネットワーク遅延と部分失敗を層別に診断する",
  "summary": "DNS、TCP、TLS、HTTPの時系列を分け、期限内に失敗を扱う予算を設計する。",
  "track": "foundations",
  "stage": 1,
  "difficulty": "foundation",
  "estimatedMinutes": 270,
  "prerequisiteIds": [
    "core-04-os-processes-concurrency"
  ],
  "objectives": [
    {
      "id": "obj-timeline",
      "statement": "DNS問い合わせからHTTP応答完了までを少なくとも六イベントの時系列として図示できる",
      "evidenceIds": [
        "trace-budget",
        "teach-back"
      ]
    },
    {
      "id": "obj-budget",
      "statement": "利用者期限から接続、TLS、応答、再試行へ時間を配分し、最悪時の合計を計算できる",
      "evidenceIds": [
        "trace-budget",
        "assessment"
      ]
    },
    {
      "id": "obj-diagnose",
      "statement": "パケット損失と依存サービス遅延の仮説を層別の時刻と再送観測で反証し、未知経路へ診断を移せる",
      "evidenceIds": [
        "assessment",
        "transfer"
      ]
    }
  ],
  "evidence": [
    {
      "id": "trace-budget",
      "kind": "artifact",
      "description": "DNSからHTTPまでの時刻、期限、再試行条件、未観測区間を含むトレース"
    },
    {
      "id": "teach-back",
      "kind": "explanation",
      "description": "輸送成功とアプリケーション成功を区別する5分説明"
    },
    {
      "id": "assessment",
      "kind": "reasoning",
      "description": "損失、名前解決、接続、依存遅延の仮説を反証する診断"
    },
    {
      "id": "transfer",
      "kind": "transfer",
      "description": "未知の多段依存で損失と依存遅延を切り分けた調査計画"
    }
  ],
  "capabilityProgression": [
    {
      "level": "recognize",
      "criterion": "DNS、TCP、TLS、HTTPの開始・完了イベントと各層の失敗を時系列上で識別できる",
      "evidenceIds": [
        "trace-budget"
      ]
    },
    {
      "level": "explain",
      "criterion": "TCP到達、TLS認証、HTTP応答、業務処理成功が別の契約である理由を説明できる",
      "evidenceIds": [
        "teach-back"
      ]
    },
    {
      "level": "apply",
      "criterion": "総期限から各段の予算と再試行回数を逆算し、合計が期限を超えないトレースを作成できる",
      "evidenceIds": [
        "trace-budget"
      ]
    },
    {
      "level": "diagnose",
      "criterion": "DNS時間、接続時間、再送、server timingを比較し、損失と依存遅延を反証できる",
      "evidenceIds": [
        "assessment"
      ]
    },
    {
      "level": "lead",
      "criterion": "冪等性、deadline伝播、retry stormを含む障害レビューを未知の依存グラフで主導できる",
      "evidenceIds": [
        "transfer"
      ]
    }
  ],
  "lab": {
    "title": "名前解決から応答完了までを期限へ収める",
    "artifact": "DNSからHTTPまでの時系列トレースとタイムアウト予算",
    "steps": [
      "cold DNSとwarm DNSで、名前解決、接続、TLS、最初のbyte、本文完了の単調時計時刻を記録する",
      "利用者期限2000msから各段の上限、後処理余白、キャンセル伝播時間を配分する",
      "一回の再試行を含む最悪時合計を計算し、期限を超える場合は試行予算を修正する",
      "制御可能な遅延依存と接続失敗を別々に注入し、時系列上の差を観測する",
      "非冪等操作では再試行を止める条件と、結果不明を照会するための識別子を記録する"
    ]
  },
  "teachBack": "5分で、DNS、TCP、TLS、HTTPの役割、TCP成功が業務成功を保証しない理由、exactly-onceを安易に主張できない理由を説明する。",
  "assessment": [
    {
      "prompt": "HTTPのp99が800msへ悪化した。『パケット損失だ』という診断と『依存DBが遅い』という診断をどう区別するか。",
      "expectedEvidence": "TCP再送または接続時間、server-side区間、依存span、同時刻比較による反証"
    },
    {
      "prompt": "POSTの応答がtimeoutした。即時retryが常に安全でない理由と必要な契約を示す。",
      "expectedEvidence": "処理済みだが応答喪失の状態、冪等key、結果照会、期限とbackoffを含む説明"
    }
  ],
  "transferTask": "パケット損失と依存遅延を区別する診断",
  "rubric": [
    {
      "dimension": "technical-correctness",
      "levels": {
        "incomplete": "TCP接続、TLS、HTTP成功、業務処理完了を同じ成功として扱う",
        "developing": "層は区別するが、再送またはtimeout後の結果不明状態を説明できない",
        "proficient": "各層のイベント、期限、失敗状態、retryの影響を正しい順序で説明する",
        "exemplary": "DNS cache、TLS 0-RTT、TCP再送、冪等性の境界と反例まで扱う"
      }
    },
    {
      "dimension": "judgment",
      "levels": {
        "incomplete": "各段へ総期限と同じtimeoutを設定し、無条件に再試行する",
        "developing": "予算を分けるが、後処理余白、deadline伝播、操作の冪等性が抜ける",
        "proficient": "利用者期限から逆算し、操作種別に応じて試行回数と停止条件を選ぶ",
        "exemplary": "retry stormと部分成功を考慮し、適応的縮退と結果照会を設計する"
      }
    },
    {
      "dimension": "evidence",
      "levels": {
        "incomplete": "総所要時間だけでネットワーク層の原因を断定する",
        "developing": "client時刻はあるが、serverまたは再送の観測と時刻基準が揃わない",
        "proficient": "単調時計の層別時刻、再送、server区間を同じ要求IDで相関する",
        "exemplary": "coldとwarm経路、複数地点、欠測区間を比較し、観測限界を結論へ反映する"
      }
    },
    {
      "dimension": "communication",
      "levels": {
        "incomplete": "ネットワークが遅いという表現だけで、層と時間帯が分からない",
        "developing": "時系列はあるが、期限超過への寄与と次の反証操作が不明である",
        "proficient": "要求ID、層別区間、予算、仮説、反証、次の操作を一枚で追跡できる",
        "exemplary": "client、network、service各担当へ責任断定を避けつつ同じ証拠を提示する"
      }
    }
  ],
  "sources": [
    {
      "id": "src-01",
      "title": "RFC 1035: Domain Names - Implementation and Specification",
      "url": "https://www.rfc-editor.org/rfc/rfc1035.html",
      "kind": "standard"
    },
    {
      "id": "src-02",
      "title": "RFC 9293: Transmission Control Protocol (TCP)",
      "url": "https://www.rfc-editor.org/rfc/rfc9293.html",
      "kind": "standard"
    },
    {
      "id": "src-03",
      "title": "RFC 6298: Computing TCP's Retransmission Timer",
      "url": "https://www.rfc-editor.org/rfc/rfc6298.html",
      "kind": "standard"
    },
    {
      "id": "src-04",
      "title": "RFC 8446: The Transport Layer Security (TLS) Protocol Version 1.3",
      "url": "https://www.rfc-editor.org/rfc/rfc8446.html",
      "kind": "standard"
    },
    {
      "id": "src-05",
      "title": "RFC 9110: HTTP Semantics",
      "url": "https://www.rfc-editor.org/rfc/rfc9110.html",
      "kind": "standard"
    }
  ],
  "visualizations": [
    {
      "id": "request-path-timeline",
      "type": "timeline",
      "caption": "DNSから業務結果までの時系列",
      "question": "説明用の総deadline 300msで、どのeventが最初の超過点となり、残りbudgetはどう変化したか。",
      "afterSection": "mentalModel",
      "objectiveIds": [
        "obj-timeline",
        "obj-budget"
      ],
      "evidenceIds": [
        "trace-budget"
      ],
      "sourceIds": [
        "src-01",
        "src-02",
        "src-04",
        "src-05"
      ],
      "expectedObservation": "各eventのbudgetと累積observedを追い、first-byteの310msを最初の超過点として説明できる。これは普遍的なlatency値ではない。",
      "notes": [],
      "payload": {
        "phases": [
          {
            "id": "connection",
            "label": "接続準備 budget 120ms",
            "detail": "説明用の総deadline 300msのうちDNS 30ms、TCP 40ms、TLS 50msを割り当てる。observed合計105ms。普遍値ではない。"
          },
          {
            "id": "exchange",
            "label": "HTTP交換 budget 160ms",
            "detail": "request 10ms、server 100ms、first-byte 20ms、body 30ms。first-byte observedで総deadlineを初めて超える。"
          },
          {
            "id": "business-result",
            "label": "業務結果 budget 20ms",
            "detail": "transport完了後の結果永続化へ20msを割り当てる。数値はtraceの読み方を示す説明用。"
          }
        ],
        "events": [
          {
            "id": "dns",
            "label": "名前解決（説明用budget）",
          "detail": "DNS queryを送り、候補addressとTTLを得る。budget 30ms、observed 25ms、累積25ms・残り275ms。",
            "phaseId": "connection",
            "order": 0
          },
          {
            "id": "tcp",
            "label": "輸送接続（説明用budget）",
          "detail": "TCP SYN、SYN-ACK、ACKで接続状態を確立する。budget 40ms、observed 35ms、累積60ms・残り240ms。",
            "phaseId": "connection",
            "order": 1
          },
          {
            "id": "tls",
            "label": "暗号接続（説明用budget）",
          "detail": "TLSでversion、鍵、相手のidentityを検証する。budget 50ms、observed 45ms、累積105ms・残り195ms。",
            "phaseId": "connection",
            "order": 2
          },
          {
            "id": "request",
            "label": "request送信（説明用budget）",
            "detail": "HTTP method、target、header、bodyを送る。budget 10ms、observed 10ms、累積115ms・残り185ms。",
            "phaseId": "exchange",
            "order": 3
          },
          {
            "id": "server",
            "label": "server処理（説明用budget）",
            "detail": "handlerと依存serviceが状態を読み書きする。budget 100ms、observed 120ms、累積235ms・残り65ms。",
            "phaseId": "exchange",
            "order": 4
          },
          {
            "id": "first-byte",
            "label": "最初のbyte（説明用budget）",
            "detail": "statusとheaderを受け始める。budget 20ms、observed 75ms、累積310ms。ここが最初のdeadline超過点（10ms超過）。",
            "phaseId": "exchange",
            "order": 5
          },
          {
            "id": "body-complete",
            "label": "本文完了（説明用budget）",
          "detail": "responseを読み終える。ただし業務結果はstatusとbodyの契約で判定する。budget 30ms、observed 25ms、累積335ms・残り-35ms。",
            "phaseId": "exchange",
            "order": 6
          },
          {
            "id": "result",
            "label": "結果確定（説明用budget）",
          "detail": "clientが結果を永続化し、必要なら冪等keyで後から照会できる。budget 20ms、observed 10ms、累積345ms・残り-45ms。",
            "phaseId": "business-result",
            "order": 7
          }
        ]
      }
    },
    {
      "id": "request-path-static",
      "type": "comparison",
      "caption": "failure注入点ごとのrequest pathとretry判断",
      "question": "DNS、TCP、TLS、request、response喪失を分けると、再試行前に何を観測すべきか。",
      "afterSection": "workedExample",
      "objectiveIds": ["obj-timeline", "obj-budget"],
      "evidenceIds": ["trace-budget"],
      "sourceIds": ["src-01", "src-02", "src-04", "src-05"],
      "expectedObservation": "接続準備とHTTP交換を混同せず、failure点、観測結果、retry条件を有限scenarioごとに説明する。",
      "notes": ["これは説明用request pathであり、実packet captureや普遍的latency配分ではない。"],
      "payload": {
        "alternatives": [
          {"id": "healthy", "label": "failureなし", "detail": "DNS、TCP、TLS、request、responseを順に完了する。"},
          {"id": "dns-point", "label": "DNS failure", "detail": "名前解決で停止し、transport接続は未開始。"},
          {"id": "tcp-point", "label": "TCP failure", "detail": "address取得後、transport接続を確立できない。"},
          {"id": "tls-point", "label": "TLS failure", "detail": "TCP後、暗号接続と相手identityの検証で停止する。"},
          {"id": "request-point", "label": "request failure", "detail": "TLS後、request送信またはserver処理でdeadlineへ到達する。"},
          {"id": "response-point", "label": "response lost", "detail": "side effectの有無が不明なままobserved responseを失う。"}
        ],
        "criteria": [
          {"id": "completed-path", "label": "完了した段階", "detail": "failureまでに完了したDNS/TCP/TLS/request段階。"},
          {"id": "observation", "label": "観測", "detail": "clientとserverのtraceで確認する事実。"},
          {"id": "retry-decision", "label": "retry判断", "detail": "残りdeadlineと冪等性を確認してから再試行する。"}
        ],
        "cells": [
          {"id": "healthy-path", "alternativeId": "healthy", "criterionId": "completed-path", "value": "DNS→TCP→TLS→request→response"},
          {"id": "healthy-observation", "alternativeId": "healthy", "criterionId": "observation", "value": "statusとbodyまで観測"},
          {"id": "healthy-retry", "alternativeId": "healthy", "criterionId": "retry-decision", "value": "retry不要"},
          {"id": "dns-path", "alternativeId": "dns-point", "criterionId": "completed-path", "value": "DNSで停止"},
          {"id": "dns-observation", "alternativeId": "dns-point", "criterionId": "observation", "value": "resolver結果とTTL"},
          {"id": "dns-retry", "alternativeId": "dns-point", "criterionId": "retry-decision", "value": "残りdeadline内で再解決"},
          {"id": "tcp-path", "alternativeId": "tcp-point", "criterionId": "completed-path", "value": "DNS完了、TCPで停止"},
          {"id": "tcp-observation", "alternativeId": "tcp-point", "criterionId": "observation", "value": "connect timeoutとaddress"},
          {"id": "tcp-retry", "alternativeId": "tcp-point", "criterionId": "retry-decision", "value": "別addressとbudgetを確認"},
          {"id": "tls-path", "alternativeId": "tls-point", "criterionId": "completed-path", "value": "DNS/TCP完了、TLSで停止"},
          {"id": "tls-observation", "alternativeId": "tls-point", "criterionId": "observation", "value": "version、証明書、identity"},
          {"id": "tls-retry", "alternativeId": "tls-point", "criterionId": "retry-decision", "value": "設定不整合なら盲目的retry禁止"},
          {"id": "request-path-cell", "alternativeId": "request-point", "criterionId": "completed-path", "value": "DNS/TCP/TLS完了、requestで停止"},
          {"id": "request-observation", "alternativeId": "request-point", "criterionId": "observation", "value": "送信量とserver trace"},
          {"id": "request-retry", "alternativeId": "request-point", "criterionId": "retry-decision", "value": "冪等性と残りdeadlineを確認"},
          {"id": "response-path", "alternativeId": "response-point", "criterionId": "completed-path", "value": "request後、response未観測"},
          {"id": "response-observation", "alternativeId": "response-point", "criterionId": "observation", "value": "side effectとresponseを別々に照会"},
          {"id": "response-retry", "alternativeId": "response-point", "criterionId": "retry-decision", "value": "同じ冪等keyで結果照会またはretry"}
        ]
      },
      "simulation": {
        "kind": "request-path", "interactionMode": "hybrid", "initialStateId": "dns-lookup", "defaultIntervalMs": 1000,
        "parameters": [
          {"id": "failure-point", "label": "failure注入点", "control": "select", "options": [{"id": "none", "label": "なし"}, {"id": "dns-fail", "label": "DNS"}, {"id": "tcp-fail", "label": "TCP"}, {"id": "tls-fail", "label": "TLS"}, {"id": "request-fail", "label": "request"}, {"id": "response-fail", "label": "response喪失"}], "defaultOptionId": "none"},
          {"id": "latency-profile", "label": "latency profile", "control": "radio", "options": [{"id": "normal-budget", "label": "normal-budget"}, {"id": "tight-budget", "label": "tight-budget"}], "defaultOptionId": "normal-budget"}
        ],
        "states": [
          {"id": "dns-lookup", "label": "DNS lookup開始", "status": "DNS→TCP→TLS→requestの固定phase listを開始する。latency profileはnormal-budget/tight-budgetの有限比較。", "activeNodeIds": ["completed-path"], "activeEdgeIds": []},
          {"id": "tcp-ready", "label": "TCP ready", "status": "DNS結果を得てTCP接続を確立。DNSとTCPの待ちを分離する。", "when": {"failure-point": "none"}, "activeNodeIds": ["healthy"], "activeEdgeIds": ["healthy-path"]},
          {"id": "tls-ready", "label": "TLS ready", "status": "TCP後にTLS version・証明書・identityを検証。", "when": {"failure-point": "none"}, "activeNodeIds": ["healthy"], "activeEdgeIds": ["healthy-path"]},
          {"id": "request-sent", "label": "request sent", "status": "TLS後にrequestを送信し、responseまたはtimeoutを待つ。", "when": {"failure-point": "none"}, "activeNodeIds": ["healthy"], "activeEdgeIds": ["healthy-path"]},
          {"id": "healthy-response", "label": "normal response observed", "status": "normal-budgetではresponseを観測しretry decisionは不要。説明用時間を普遍値にしない。", "when": {"failure-point": "none", "latency-profile": "normal-budget"}, "activeNodeIds": ["healthy"], "activeEdgeIds": ["healthy-path", "healthy-observation"]},
          {"id": "healthy-tight-deadline", "label": "tight profile timeout", "status": "tight-budgetでは同じphase sampleがdeadline超過。残りbudgetなしとしてretryしない。", "when": {"failure-point": "none", "latency-profile": "tight-budget"}, "activeNodeIds": ["healthy"], "activeEdgeIds": ["healthy-path", "healthy-retry"]},
          {"id": "dns-failure", "label": "DNS failure normal", "status": "normal-budgetでDNS停止。TCP/TLS/requestは未開始。", "when": {"failure-point": "dns-fail", "latency-profile": "normal-budget"}, "activeNodeIds": ["dns-point"], "activeEdgeIds": ["dns-path", "dns-retry"]},
          {"id": "dns-failure-tight", "label": "DNS failure tight", "status": "tight-budgetでDNS停止。残りdeadline不足ならretry禁止。", "when": {"failure-point": "dns-fail", "latency-profile": "tight-budget"}, "activeNodeIds": ["dns-point"], "activeEdgeIds": ["dns-path", "dns-retry"]},
          {"id": "tcp-failure", "label": "TCP failure normal", "status": "normal-budgetでDNS完了後TCP停止。TLS/requestとは分ける。", "when": {"failure-point": "tcp-fail", "latency-profile": "normal-budget"}, "activeNodeIds": ["tcp-point"], "activeEdgeIds": ["tcp-path", "tcp-retry"]},
          {"id": "tcp-failure-tight", "label": "TCP failure tight", "status": "tight-budgetでTCP停止。残りdeadline不足ならretry禁止。", "when": {"failure-point": "tcp-fail", "latency-profile": "tight-budget"}, "activeNodeIds": ["tcp-point"], "activeEdgeIds": ["tcp-path", "tcp-retry"]},
          {"id": "tls-failure", "label": "TLS config mismatch normal", "status": "normal-budgetでもTLS設定不整合なのでretry禁止。設定修正がrecovery。", "when": {"failure-point": "tls-fail", "latency-profile": "normal-budget"}, "activeNodeIds": ["tls-point"], "activeEdgeIds": ["tls-path", "tls-retry"]},
          {"id": "tls-failure-tight", "label": "TLS config mismatch tight", "status": "tight-budgetでも設定不整合なのでretry禁止。budget延長では直らない。", "when": {"failure-point": "tls-fail", "latency-profile": "tight-budget"}, "activeNodeIds": ["tls-point"], "activeEdgeIds": ["tls-path", "tls-retry"]},
          {"id": "request-failure", "label": "request timeout normal", "status": "normal-budgetでrequest timeout。冪等性と残りdeadlineからretry decision。", "when": {"failure-point": "request-fail", "latency-profile": "normal-budget"}, "activeNodeIds": ["request-point"], "activeEdgeIds": ["request-path-cell", "request-retry"]},
          {"id": "request-failure-tight", "label": "request timeout tight", "status": "tight-budgetでは残りdeadlineなし。冪等keyで照会しretry禁止。", "when": {"failure-point": "request-fail", "latency-profile": "tight-budget"}, "activeNodeIds": ["request-point"], "activeEdgeIds": ["request-path-cell", "request-retry"]},
          {"id": "deadline-exceeded", "label": "response未観測 normal", "status": "normal-budgetでresponse喪失。side effectは不明のまま同じ冪等keyで照会しretry decision。", "when": {"failure-point": "response-fail", "latency-profile": "normal-budget"}, "activeNodeIds": ["response-point"], "activeEdgeIds": ["response-path", "response-retry"]},
          {"id": "deadline-exceeded-tight", "label": "response未観測 tight", "status": "tight-budgetでresponse喪失。side effectは不明、残りdeadlineなしなので照会を優先。", "when": {"failure-point": "response-fail", "latency-profile": "tight-budget"}, "activeNodeIds": ["response-point"], "activeEdgeIds": ["response-path", "response-retry"]}
        ],
