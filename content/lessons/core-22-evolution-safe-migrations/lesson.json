      ]
    }
  ],
  "lab": {
    "title": "顧客名columnのexpand-contract migrationを設計する",
    "artifact": "expand-contract段階、観測、停止、ロールバックを含む移行計画",
    "steps": [
      "old readerとnew readerを同時に支える五つのphase、観測、停止条件、rollbackを定義する",
      "fixed simulated observationからcompatibilityとbackfill error rateを検査しcontinue判断を導く",
      "backfill error rateだけを上げ、同じmigration planがrollbackへ遷移することを検証する"
    ]
  },
  "teachBack": "5分で、DORA database change management、PostgreSQL 18 ALTER TABLE、logical replication Restrictionsを、具体的なexpand-contract順序と停止判断へどう変換するか説明する。",
  "assessment": [
    {
      "prompt": "new columnを追加して全rowを一括更新し、直後にold columnを削除する計画を評価せよ。",
      "expectedEvidence": "lock、old reader、new reader、dual write、backfill、観測、contract gate、rollback"
    },
    {
      "prompt": "migration commandが成功したので配信完了とする判断を評価せよ。",
      "expectedEvidence": "command successとsystem outcomeの区別、reader compatibility、write parity、backfill error、rollback outcome"
    }
  ],
  "transferTask": "backfill error rateだけを変え、同じ移行計画の継続・停止・ロールバック判断を再評価する",
  "rubric": [
    {
      "dimension": "technical-correctness",
      "levels": {
        "incomplete": "破壊的DDLを一段で実行し互換期間がない",
        "developing": "phaseはあるがreader、writer、backfillの互換性が曖昧である",
        "proficient": "五phaseと観測、停止、rollback、compatibilityを一貫して追跡する",
        "exemplary": "retry、replication lag、混在versionでも遷移不変条件を検査できる"
      }
    },
    {
      "dimension": "judgment",
      "levels": {
        "incomplete": "DDL command successだけでcontractへ進む",
        "developing": "metricは見るが停止thresholdと権限がない",
        "proficient": "error、drift、互換性、可逆性からcontinue、stop、rollbackを選ぶ",
        "exemplary": "業務riskと回復時間に応じてphase幅と観測期間を調整する"
      }
    },
    {
      "dimension": "evidence",
      "levels": {
        "incomplete": "手順書だけで実行観測がない",
        "developing": "件数はあるがerror rate、reader結果、限界がない",
        "proficient": "固定入力、threshold、phase observation、decisionを再計算可能に残す",
        "exemplary": "rollback後のsystem outcomeとcontract前の証拠を監査可能にする"
      }
    },
    {
      "dimension": "communication",
      "levels": {
        "incomplete": "DB担当だけが順序を知っている",
        "developing": "phase名はあるがownerと停止条件が読めない",
        "proficient": "各phaseの互換性、観測、停止、rollbackを職能横断で共有できる",
        "exemplary": "application、database、operationsが同じstate machineで異議と再開を判断できる"
      }
    }
  ],
